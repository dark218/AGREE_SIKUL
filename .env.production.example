APP_NAME="AGREE SIKUL"
APP_ENV=production
APP_KEY=base64:S9NL4VYu12Z/vSjrwpjggm5B/LjiP8iTRHOi6r9OO1k=
APP_DEBUG=false
APP_TIMEZONE=UTC

# APP_URL doit matcher le domaine Dokploy (override possible via DOKPLOY_DOMAIN)
APP_URL=https://CHANGEME.traefik.me

# Tunnel switch : local | ngrok | prod (cf. config/app.php et AppServiceProvider)
APP_TUNNEL=prod
APP_URL_LOCAL=http://localhost:8091
APP_URL_NGROK=https://CHANGEME.ngrok-free.app

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# === Database (override dans Dokploy UI pour les credentials) ===
DB_CONNECTION=mysql
DB_HOST=64.227.83.83
DB_PORT=3306
DB_DATABASE=agree_sikul
DB_USERNAME=root
DB_PASSWORD=Agriconnect2025

# === Sessions / Cookies (HTTPS via Dokploy + Traefik) ===
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true uniquement si HTTPS actif (Let's Encrypt via Dokploy)
# Si l'URL d'accès est HTTP, mets false sinon erreur 419 PAGE EXPIRED
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=agreesikul_session

# === Cache / Queue / Broadcast ===
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# === Mail ===
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@agreesikul.com"
MAIL_FROM_NAME="${APP_NAME}"

# === AWS S3 (optionnel) ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# === Pusher (broadcast websockets) ===
BROADCAST_DRIVER=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

GUZZLE_VERIFY=false

# === JWT ===
JWT_SECRET=CHANGEME_GENERATE_WITH_php_artisan_jwt_secret
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256

# === Firebase Cloud Messaging (notifications push) ===
